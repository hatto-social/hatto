        {"k": 0, "fields": ["alpha", "beta"], "tags": ["basic"]},
        {"k": 1, "fields": ["gamma", "delta"], "tags": ["basic"]}
      ],
      "expect": {
        "outcome": "committed",
        "counts": {
          "newNotes": 2,
          "same": 0,
          "changed": 0,
          "localNewer": 0,
          "blocked": 0,
          "dup": 0,
          "noResidentCall": false
        },
