#include "../../Flutter/Flutter-Release.xcconfig"
#include "Warnings.xcconfig"

// v0 does not sign or notarize. CI sets the same switches.
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
CODE_SIGN_IDENTITY = -

// Apple Silicon only. A universal Release binary would make
// `flutter build macos --release` compile x86_64-apple-darwin as well.
ARCHS = arm64
EXCLUDED_ARCHS = x86_64
